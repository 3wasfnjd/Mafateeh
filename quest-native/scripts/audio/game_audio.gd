class_name GameAudio
extends Node
## Sound effects and ambience. All sounds are local files in res://audio
## (generated by tools/audio/generate_audio.py), triggered by gameplay events,
## never per frame. Positional voices are children of the board, so a sound
## stays on its visible source when the board moves, rotates or resizes.
##
## Buses: Master (limiter) <- SFX, Ambience, Rain (low-pass for indoors), UI.
## Player volumes: master; effects (SFX + UI); ambience (Ambience + Rain).

const SFX_DIR := "res://audio/sfx/"
const AMB_DIR := "res://audio/ambience/"
const VOICES := 14
const COOLDOWN := 0.06

var board: BoardPlacement
var game: Game
var sky: SkyWeather
var _streams := {}
var _pool: Array = []
var _next := 0
var _last := {}
var _loops := {}  # name -> AudioStreamPlayer3D
var _ui: AudioStreamPlayer
var _rain_lpf: AudioEffectLowPassFilter
var _indoor := 0.0
var _bird_t := 4.0
var _rng := RandomNumberGenerator.new()
var _scrape: AudioStreamPlayer3D
var paused := false


func setup(b: BoardPlacement, g: Game, s: SkyWeather) -> void:
	board = b
	game = g
	sky = s
	_make_buses()
	for i in VOICES:
		var p := _voice("SFX")
		_pool.append(p)
	_ui = AudioStreamPlayer.new()
	_ui.bus = "UI"
	add_child(_ui)
	for name in ["wind", "birds_bed", "night", "water", "rain_stone", "rain_water", "rain_roof"]:
		var p := _voice("Rain" if name.begins_with("rain") else "Ambience")
		p.stream = _stream(name, true)
		p.volume_db = -80.0
		p.unit_size = 3.0
		p.set_meta("target", -80.0)
		_loops[name] = p
	_scrape = _voice("SFX")
	game.feedback.connect(_on_feedback)
	game.mechanism.connect(on_mechanism)
	game.level_loaded.connect(_on_level)
	game.hero.footstep.connect(_on_footstep)
	game.hero.cloth.connect(_on_cloth)
	apply_volume()


func _make_buses() -> void:
	if AudioServer.get_bus_index("SFX") >= 0:
		return
	var limiter := AudioEffectHardLimiter.new()
	limiter.ceiling_db = -1.0
	AudioServer.add_bus_effect(0, limiter)
	for n in ["SFX", "Ambience", "Rain", "UI"]:
		AudioServer.add_bus()
		var i := AudioServer.bus_count - 1
		AudioServer.set_bus_name(i, n)
		AudioServer.set_bus_send(i, "Master")
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("Ambience"), -6.0)
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("Rain"), -5.0)
	_rain_lpf = AudioEffectLowPassFilter.new()
	_rain_lpf.cutoff_hz = 20000.0
	AudioServer.add_bus_effect(AudioServer.get_bus_index("Rain"), _rain_lpf)


func _voice(bus: String) -> AudioStreamPlayer3D:
	var p := AudioStreamPlayer3D.new()
	p.bus = bus
	# Tabletop tuning: sources sit 0.3–2 m away whatever the board size, so a
	# gentle inverse curve keeps feedback audible without getting loud.
	p.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
	p.unit_size = 1.2
	p.max_db = 0.0
	p.max_distance = 8.0
	p.attenuation_filter_cutoff_hz = 20500.0
	p.panning_strength = 0.8
	p.doppler_tracking = AudioStreamPlayer3D.DOPPLER_TRACKING_DISABLED
	board.add_child(p)
	return p


func _stream(name: String, loop := false) -> AudioStream:
	var key := name + ("#loop" if loop else "")
	if _streams.has(key):
		return _streams[key]
	var path := (AMB_DIR if loop else SFX_DIR) + name + ".wav"
	var s: AudioStream = null
	if ResourceLoader.exists(path):
		s = load(path)
	if s is AudioStreamWAV and loop:
		var w := (s as AudioStreamWAV).duplicate() as AudioStreamWAV
		w.loop_mode = AudioStreamWAV.LOOP_FORWARD
		w.loop_begin = 0
		w.loop_end = int(w.get_length() * w.mix_rate)
		s = w
	_streams[key] = s
	return s


## Variants: "foot_stone" picks foot_stone_1..N at random.
func _variant(base: String) -> AudioStream:
	var options: Array = []
	for i in range(1, 7):
		var s := _stream("%s_%d" % [base, i])
		if s:
			options.append(s)
	if options.is_empty():
		return _stream(base)
	return options[_rng.randi() % options.size()]


func play(name: String, local_pos: Vector3, volume_db := 0.0, pitch := 1.0, variants := false) -> AudioStreamPlayer3D:
	if paused:
		return null
	var now := Time.get_ticks_msec() / 1000.0
	if now - float(_last.get(name, -10.0)) < COOLDOWN:
		return null
	_last[name] = now
	var s := _variant(name) if variants else _stream(name)
	if s == null:
		return null
	# Reuse the oldest voice; never allocate during play.
	var p: AudioStreamPlayer3D = _pool[_next]
	_next = (_next + 1) % _pool.size()
	p.stream = s
	p.position = local_pos
	p.volume_db = volume_db
	p.pitch_scale = pitch * _rng.randf_range(0.97, 1.03)
	p.play()
	return p


func play_later(delay: float, name: String, local_pos: Vector3, volume_db := 0.0) -> void:
	get_tree().create_timer(delay).timeout.connect(func(): play(name, local_pos, volume_db))


func ui(name: String) -> void:
	if paused:
		return
	var s := _stream("ui_" + name)
	if s:
		_ui.stream = s
		_ui.play()


# --- gameplay events ------------------------------------------------------------------

func _on_feedback(event: String, at: Vector3) -> void:
	var st := game.state
	match event:
		"key": play("key_pickup", at)
		"gem": play("gem_pickup", at)
		"unlock":
			play("latch_click", at)
			play_later(0.18, "unlock", at, -2.0)
		"lever":
			play("lever", at)
		"circuit":
			var lit := 0
			for i in int(st.def.circuit.count):
				if st.bits & (1 << i):
					lit += 1
			play("switch_%d" % clampi(lit, 0, 4), at, -2.0)
		"sequence":
			play("seq_%d" % clampi(st.sequence, 1, 6), at, -3.0)
		"sequence_done":
			play("seq_%d" % clampi(st.sequence, 1, 6), at, -3.0)
		"portal": play("portal", at, -3.0)
		"mirror": play("mirror_click", at)
		"dial": play("dial_click", at)
		"pickup_weight": play("weight_lift", at)
		"place_weight":
			play("weight_place", at)
			play_later(0.15, "balance_creak", at, -4.0)
		"pickup_brick": play("brick_lift", at)
		"place_brick": play("brick_place", at)
		"drop_brick": play("brick_drop", at)
		"push_start":
			_scrape.stream = _stream("crate_scrape")
			_scrape.position = at
			_scrape.volume_db = -3.0
			if _scrape.stream and not paused:
				_scrape.play()
		"crate_settle":
			_scrape.stop()
			play("crate_settle", at)
			play_later(0.1, "plate_click", at, -2.0)
		"solved":
			play("success", at, -4.0)
		"exit":
			play("level_complete", at, -3.0)
		"reject", "sequence_wrong":
			play("soft_reject", at, -6.0)
		"tap":
			play("tap", at, -14.0)
		"undo":
			play("ui_close", at, -6.0)
		"secret":
			play("gem_pickup", at)
			play_later(0.2, "seq_6", at, -4.0)
		"sluice":
			play("lever", at)
			play_later(0.25, "bridge_move", at, -8.0)
		"wait":
			play("dial_click", at, -2.0)
		"falcon_ready":
			play("bird_2", at, -4.0)
		"falcon":
			play("bird_1", at, -2.0)
		"falcon_cancel":
			play("tap", at, -12.0)
		"crate_push", "crate_pull":
			pass  # the scrape and settle come from push_start / crate_settle
		"drop_weight":
			play("weight_place", at)


## Mechanism transitions reported by the level view (doors, bridges, gates).
func on_mechanism(kind: String, opened: bool, at: Vector3) -> void:
	match kind:
		"door", "exit":
			play("door_creak" if opened else "door_close", at, -3.0)
		"bridge", "pool_bridge", "stones":
			play("bridge_move", at, -4.0)
		"hot":
			pass  # shade moving is silent
		"stairs":
			play("gate_lift", at, -4.0)
		"light":
			if opened:
				play("receiver_on", at, -3.0)
		"balance":
			if opened:
				play("balance_ok", at, -3.0)


func _on_footstep(surface: String, at: Vector3, strength: float) -> void:
	play("foot_" + surface, at, linear_to_db(clampf(strength, 0.2, 1.0)) - 9.0, 1.0, true)


func _on_cloth(at: Vector3, strength: float) -> void:
	play("cloth", at, linear_to_db(clampf(strength, 0.1, 1.0)) - 16.0, 1.0, true)


# --- ambience -------------------------------------------------------------------------

func _on_level(_n: int) -> void:
	_scrape.stop()
	var def := game.state.def
	var water_at := Vector3.INF
	if def.get("moat", false):
		water_at = Vector3(0, 0.1, 0)
	elif def.get("pool_room", false):
		water_at = Vector3(-2.05, 0.1, -1.45)
	_loops.water.position = water_at if water_at != Vector3.INF else Vector3.ZERO
	_loops.water.set_meta("enabled", water_at != Vector3.INF)
	_loops.rain_water.position = _loops.water.position
	for n in ["wind", "night", "rain_stone", "rain_roof", "birds_bed"]:
		_loops[n].position = Vector3(0, 1.0, 0)
	for r in def.get("roofs", []):
		_loops.rain_roof.position = Vector3(r[0], 1.4, r[1])


func _target(name: String, db: float) -> void:
	_loops[name].set_meta("target", db)


func _process(delta: float) -> void:
	if game == null or game.state == null:
		return
	var t := sky.time_name
	var rain := sky.rain_amount
	var water: bool = _loops.water.get_meta("enabled", false)
	var night := t == "night"
	_target("wind", lerpf(-20.0, -14.0, rain) if not night else -24.0)
	_target("birds_bed", -80.0)
	_target("night", -20.0 if night else -80.0)
	_target("water", -16.0 if water else -80.0)
	_target("rain_stone", lerpf(-60.0, -11.0, rain) if rain > 0.01 else -80.0)
	_target("rain_water", (lerpf(-60.0, -14.0, rain) if rain > 0.01 else -80.0) if water else -80.0)
	_target("rain_roof", (lerpf(-60.0, -15.0, rain) if rain > 0.01 else -80.0) if not game.state.def.get("roofs", []).is_empty() else -80.0)
	for name in _loops:
		var p: AudioStreamPlayer3D = _loops[name]
		var target: float = p.get_meta("target")
		# Fade loops cleanly instead of cutting them.
		p.volume_db = move_toward(p.volume_db, target, delta * 30.0)
		var should := p.volume_db > -79.0 and p.stream != null and not paused
		if should and not p.playing:
			p.play(_rng.randf() * maxf(p.stream.get_length() - 0.1, 0.0))
		elif not should and p.playing:
			p.stop()
	# Sparse daytime birds, never at night or in heavy rain.
	_bird_t -= delta
	if _bird_t <= 0.0:
		_bird_t = _rng.randf_range(7.0, 16.0)
		if (t == "day" or t == "dawn") and rain < 0.3:
			var a := _rng.randf() * TAU
			play("bird", Vector3(cos(a) * 4.5, 2.5, sin(a) * 4.0), -18.0, _rng.randf_range(0.9, 1.15), true)
	# Indoors (under a roof): muffle and lower the rain.
	var hero := game.motor.pos
	var target_in := 1.0 if game.view and game.view.is_roofed(hero) else 0.0
	_indoor = move_toward(_indoor, target_in, delta * 2.0)
	if _rain_lpf:
		_rain_lpf.cutoff_hz = lerpf(20000.0, 900.0, _indoor)
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("Rain"), -5.0 - 6.0 * _indoor + _gain(Save.ambience_volume))


func set_paused(p: bool) -> void:
	paused = p
	for v in _pool:
		v.stream_paused = p
	_scrape.stream_paused = p
	for n in _loops:
		_loops[n].stream_paused = p
	AudioServer.set_bus_mute(0, p or Save.muted)


static func _gain(v: float) -> float:
	return linear_to_db(maxf(v, 0.0001))


func apply_volume() -> void:
	AudioServer.set_bus_volume_db(0, _gain(Save.master_volume))
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("SFX"), _gain(Save.sfx_volume))
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("UI"), _gain(Save.sfx_volume))
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("Ambience"), -6.0 + _gain(Save.ambience_volume))
	AudioServer.set_bus_mute(0, Save.muted or paused)
